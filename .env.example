# NEVER commit your real .env file.
ADMIN_USERNAME=your_admin_username
# Generate the hash by running SETUP_ADMIN.bat; do not put a plain password here.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional: if your frontend is hosted on another origin, set it here.
# FRONTEND_ORIGIN=https://yourname.github.io
# Plugin/server-to-backend token. Keep this secret too.
# ONYX_INGEST_TOKEN=

# Persistent PostgreSQL database. Required for Render deployments.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL=false
